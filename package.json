{
  "name": "fsd-sdg4",
  "version": "0.0.0",
  "private": true,
  "description": "FSD-SDG-4 Quality Education SaaS — Multi-tenant platform supporting UN SDG 4",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --filter './packages/*' build && pnpm --filter './apps/*' build",
    "test": "pnpm --recursive --filter './packages/*' test && pnpm --recursive --filter './apps/*' test",
    "test:unit": "pnpm --recursive test:unit",
    "test:e2e": "pnpm --filter '@fsd-sdg4/web' test:e2e",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css}\" --ignore-path .gitignore",
    "typecheck": "pnpm --filter './packages/*' build && pnpm --recursive typecheck",
    "clean": "pnpm --recursive clean && rimraf node_modules",
    "prepare": "echo 'Monorepo root ready'"
  },
  "dependencies": {
    "@prisma/composer": "0.40.0",
    "@prisma/composer-prisma-cloud": "0.40.0",
    "@prisma/orm-postgres": "8.0.0-rc.25",
    "effect": "4.1.4",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "prisma": "8.0.0-rc.35",
    "rimraf": "6.1.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "8.72.1"
  },
  "pnpm": {
    "overrides": {
      "@effect/platform-bun": "4.1.4",
      "@effect/platform-node": "4.1.4",
      "@effect/platform-node-shared": "4.1.4"
    }
  }
}
