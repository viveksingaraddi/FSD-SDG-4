    "test:unit": "vitest run"
  },
  "dependencies": {
    "@fsd-sdg4/shared-types": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "6.1.4",
    "typescript": "^5.8.2",
    "vitest": "5.1.0"
  }
}
