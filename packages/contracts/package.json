{
  "name": "@fsd-sdg4/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "API contract types and route path constants. Owns the canonical /api/v1 contract surface.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
