# FSD-SDG-4 API — Environment Variable Template
# Copy this file to .env for local development.
# NEVER commit .env to source control.
# All values below are PLACEHOLDER EXAMPLES ONLY.

# Application
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
API_VERSION=0.0.0

# CORS — must match the Vite dev server origin
CORS_ORIGIN=http://localhost:5173

# Database (Phase 5 will finalize schema)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/fsdsdg4_dev

# Application Public Base URL
APP_BASE_URL=http://localhost:5173

# Gmail SMTP Email Delivery
# Note: In development with Gmail, generate an App Password via Google Account Security > 2-Step Verification > App passwords.
# NEVER commit your actual App Password or email credentials.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=your_organization_email@gmail.com
MAIL_APP_PASSWORD=your_16_character_app_password
MAIL_FROM_NAME="FSD-SDG-4 Quality Education"

