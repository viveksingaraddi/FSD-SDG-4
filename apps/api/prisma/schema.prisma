// FSD-SDG-4 Quality Education SaaS — Physical PostgreSQL Schema
// Phase 5: Multi-tenant relational schema with composite tenant foreign keys.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum SchoolStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum AcademicYearStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum CourseTeacherRole {
  PRIMARY
  ASSISTANT
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  TRANSFERRED
  INACTIVE
}

enum EnrollmentStatus {
  ACTIVE
  WITHDRAWN
  COMPLETED
}

enum GuardianRelationshipType {
  MOTHER
  FATHER
  LEGAL_GUARDIAN
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ResourceType {
  TEXT_GUIDE
  EXTERNAL_LINK
  DOCUMENT
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubmissionStatus {
  SUBMITTED
  LATE
  GRADED
}

enum SupportFlagType {
  ATTENDANCE_RISK
  ACADEMIC_ENGAGEMENT_RISK
  ACADEMIC_MASTERY_RISK
}

enum SupportSeverity {
  LOW
  MEDIUM
  HIGH
}

enum SupportFlagStatus {
  PROPOSED
  CONFIRMED
  DISMISSED
  IN_PLAN
  RESOLVED
}

enum SupportPlanStatus {
  DRAFT
  ACTIVE
  RESOLVED
  ESCALATED
  DISCONTINUED
}

enum ActionItemStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SupportReviewOutcome {
  RESOLVED
  CONTINUED
  ESCALATED
}

// ============================================================================
// 1. TENANCY & IDENTITY
// ============================================================================

model School {
  id           String       @id @default(uuid()) @db.Uuid
  name         String       @db.VarChar(200)
  code         String       @unique @db.VarChar(64)
  subdomain    String       @unique @db.VarChar(64)
  contactEmail String       @map("contact_email") @db.VarChar(255)
  status       SchoolStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?    @map("deleted_at") @db.Timestamptz(6)

  users                 User[]
  sessions              Session[]
  academicYears         AcademicYear[]
  classes               Class[]
  sections              Section[]
  subjects              Subject[]
  courseOfferings       CourseOffering[]
  courseTeachers        CourseTeacher[]
  teacherProfiles       TeacherProfile[]
  studentProfiles       StudentProfile[]
  enrollments           Enrollment[]
  guardianRelationships GuardianRelationship[]
  attendanceRecords     AttendanceRecord[]
  learningResources     LearningResource[]
  assignments           Assignment[]
  assignmentSubmissions AssignmentSubmission[]
  assessments           Assessment[]
  assessmentResults     AssessmentResult[]
  feedbacks             Feedback[]
  progressSnapshots     ProgressSnapshot[]
  supportFlags          SupportFlag[]
  supportPlans          SupportPlan[]
  supportPlanActions    SupportPlanAction[]
  supportReviews        SupportReview[]
  auditLogs             AuditLog[]

  @@index([status])
  @@map("schools")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  schoolId     String?    @map("school_id") @db.Uuid
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  role         UserRole
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)

  school                    School?                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sessions                  Session[]
  passwordResetTokens       PasswordResetToken[]
  teacherProfile            TeacherProfile?
  studentProfile            StudentProfile?
  guardianLinks             GuardianRelationship[]
  recordedAttendance        AttendanceRecord[]
  createdResources          LearningResource[]
  createdAssignments        Assignment[]
  gradedSubmissions         AssignmentSubmission[]
  createdAssessments        Assessment[]
  recordedAssessmentResults AssessmentResult[]
  authoredFeedbacks         Feedback[]
  reviewedSupportFlags      SupportFlag[]
  ledSupportPlans           SupportPlan[]
  assignedSupportActions    SupportPlanAction[]
  authoredSupportReviews    SupportReview[]
  auditLogs                 AuditLog[]

  @@unique([schoolId, id])
  @@index([schoolId, role, status])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  schoolId  String?  @map("school_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(512)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([schoolId, expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

// ============================================================================
// 2. ACADEMIC HIERARCHY
// ============================================================================

model AcademicYear {
  id        String             @id @default(uuid()) @db.Uuid
  schoolId  String             @map("school_id") @db.Uuid
  name      String             @db.VarChar(64)
  startDate DateTime           @map("start_date") @db.Date
  endDate   DateTime           @map("end_date") @db.Date
  status    AcademicYearStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections          Section[]
  courseOfferings   CourseOffering[]
  enrollments       Enrollment[]
  progressSnapshots ProgressSnapshot[]

  @@unique([schoolId, id])
  @@unique([schoolId, name])
  @@index([schoolId, status])
  @@map("academic_years")
}

model Class {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  name      String   @db.VarChar(100)
  stage     String   @db.VarChar(64)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections Section[]

  @@unique([schoolId, id])
  @@unique([schoolId, name])
  @@index([schoolId, sortOrder])
  @@map("classes")
}

model Section {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  classId        String   @map("class_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  name           String   @db.VarChar(64)
  capacity       Int?
  roomNumber     String?  @map("room_number") @db.VarChar(32)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class             Class              @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Restrict)
  academicYear      AcademicYear       @relation(fields: [schoolId, academicYearId], references: [schoolId, id], onDelete: Restrict)
  courseOfferings   CourseOffering[]
  enrollments       Enrollment[]
  attendanceRecords AttendanceRecord[]

  @@unique([schoolId, id])
  @@unique([schoolId, academicYearId, classId, name])
  @@index([schoolId, academicYearId])
  @@index([schoolId, classId])
  @@map("sections")
}

model Subject {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  name        String   @db.VarChar(120)
  code        String   @db.VarChar(32)
  description String?  @db.VarChar(500)
  credits     Decimal? @db.Decimal(4, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  courseOfferings CourseOffering[]

  @@unique([schoolId, id])
  @@unique([schoolId, code])
  @@index([schoolId, name])
  @@map("subjects")
}

model CourseOffering {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  sectionId      String   @map("section_id") @db.Uuid
  subjectId      String   @map("subject_id") @db.Uuid
  syllabus       String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear      AcademicYear       @relation(fields: [schoolId, academicYearId], references: [schoolId, id], onDelete: Restrict)
  section           Section            @relation(fields: [schoolId, sectionId], references: [schoolId, id], onDelete: Restrict)
  subject           Subject            @relation(fields: [schoolId, subjectId], references: [schoolId, id], onDelete: Restrict)
  courseTeachers    CourseTeacher[]
  learningResources LearningResource[]
  assignments       Assignment[]
  assessments       Assessment[]

  @@unique([schoolId, id])
  @@unique([schoolId, academicYearId, sectionId, subjectId])
  @@index([schoolId, sectionId])
  @@index([schoolId, subjectId])
  @@map("course_offerings")
}

model CourseTeacher {
  id               String            @id @default(uuid()) @db.Uuid
  schoolId         String            @map("school_id") @db.Uuid
  courseOfferingId String            @map("course_offering_id") @db.Uuid
  teacherId        String            @map("teacher_id") @db.Uuid
  role             CourseTeacherRole @default(PRIMARY)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  school         School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  courseOffering CourseOffering @relation(fields: [schoolId, courseOfferingId], references: [schoolId, id], onDelete: Cascade)
  teacher        TeacherProfile @relation(fields: [schoolId, teacherId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, courseOfferingId, teacherId])
  @@index([schoolId, teacherId])
  @@map("course_teachers")
}

// ============================================================================
// 3. ROSTERS & PROFILES
// ============================================================================

model TeacherProfile {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.VarChar(64)
  firstName      String   @map("first_name") @db.VarChar(100)
  lastName       String   @map("last_name") @db.VarChar(100)
  specialization String?  @db.VarChar(150)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school            School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [schoolId, userId], references: [schoolId, id], onDelete: Restrict)
  courseAssignments CourseTeacher[]

  @@unique([schoolId, id])
  @@unique([schoolId, userId])
  @@unique([schoolId, employeeId])
  @@index([schoolId, lastName, firstName])
  @@map("teacher_profiles")
}

model StudentProfile {
  id              String        @id @default(uuid()) @db.Uuid
  schoolId        String        @map("school_id") @db.Uuid
  userId          String        @unique @map("user_id") @db.Uuid
  studentIdNumber String        @map("student_id_number") @db.VarChar(64)
  firstName       String        @map("first_name") @db.VarChar(100)
  lastName        String        @map("last_name") @db.VarChar(100)
  dateOfBirth     DateTime?     @map("date_of_birth") @db.Date
  gender          String?       @db.VarChar(32)
  status          StudentStatus @default(ACTIVE)
  admissionDate   DateTime      @map("admission_date") @db.Date
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(6)

  school                School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user                  User                   @relation(fields: [schoolId, userId], references: [schoolId, id], onDelete: Restrict)
  enrollments           Enrollment[]
  guardianLinks         GuardianRelationship[]
  attendanceRecords     AttendanceRecord[]
  assignmentSubmissions AssignmentSubmission[]
  assessmentResults     AssessmentResult[]
  progressSnapshots     ProgressSnapshot[]
  supportFlags          SupportFlag[]
  supportPlans          SupportPlan[]

  @@unique([schoolId, id])
  @@unique([schoolId, userId])
  @@unique([schoolId, studentIdNumber])
  @@index([schoolId, status, lastName, firstName])
  @@map("student_profiles")
}

model Enrollment {
  id             String           @id @default(uuid()) @db.Uuid
  schoolId       String           @map("school_id") @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  sectionId      String           @map("section_id") @db.Uuid
  academicYearId String           @map("academic_year_id") @db.Uuid
  status         EnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  school       School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      StudentProfile @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Restrict)
  section      Section        @relation(fields: [schoolId, sectionId], references: [schoolId, id], onDelete: Restrict)
  academicYear AcademicYear   @relation(fields: [schoolId, academicYearId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, studentId, academicYearId])
  @@index([schoolId, sectionId, status])
  @@index([schoolId, academicYearId])
  @@map("enrollments")
}

model GuardianRelationship {
  id               String                   @id @default(uuid()) @db.Uuid
  schoolId         String                   @map("school_id") @db.Uuid
  guardianUserId   String                   @map("guardian_user_id") @db.Uuid
  studentId        String                   @map("student_id") @db.Uuid
  relationshipType GuardianRelationshipType @map("relationship_type")
  isPrimaryContact Boolean                  @default(false) @map("is_primary_contact")
  isVerified       Boolean                  @default(false) @map("is_verified")
  verifiedAt       DateTime?                @map("verified_at") @db.Timestamptz(6)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  school       School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  guardianUser User           @relation(fields: [schoolId, guardianUserId], references: [schoolId, id], onDelete: Restrict)
  student      StudentProfile @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Cascade)

  @@unique([schoolId, guardianUserId, studentId])
  @@index([schoolId, studentId])
  @@map("guardian_relationships")
}

// ============================================================================
// 4. DAILY OPERATIONS & ATTENDANCE
// ============================================================================

model AttendanceRecord {
  id              String           @id @default(uuid()) @db.Uuid
  schoolId        String           @map("school_id") @db.Uuid
  sectionId       String           @map("section_id") @db.Uuid
  studentId       String           @map("student_id") @db.Uuid
  recordedById    String           @map("recorded_by_id") @db.Uuid
  attendanceDate  DateTime         @map("attendance_date") @db.Date
  status          AttendanceStatus
  lateMinutes     Int?             @map("late_minutes")
  remarks         String?          @db.VarChar(500)
  amendmentReason String?          @map("amendment_reason") @db.VarChar(500)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  school     School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section    Section        @relation(fields: [schoolId, sectionId], references: [schoolId, id], onDelete: Restrict)
  student    StudentProfile @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Restrict)
  recordedBy User           @relation(fields: [schoolId, recordedById], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, sectionId, studentId, attendanceDate])
  @@index([schoolId, sectionId, attendanceDate])
  @@index([schoolId, studentId, attendanceDate])
  @@index([schoolId, recordedById])
  @@map("attendance_records")
}

model LearningResource {
  id               String        @id @default(uuid()) @db.Uuid
  schoolId         String        @map("school_id") @db.Uuid
  courseOfferingId String        @map("course_offering_id") @db.Uuid
  createdById      String        @map("created_by_id") @db.Uuid
  title            String        @db.VarChar(200)
  description      String?       @db.Text
  resourceType     ResourceType  @map("resource_type")
  url              String?       @db.VarChar(1024)
  fileKey          String?       @map("file_key") @db.VarChar(512)
  status           PublishStatus @default(DRAFT)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  school         School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  courseOffering CourseOffering @relation(fields: [schoolId, courseOfferingId], references: [schoolId, id], onDelete: Cascade)
  createdBy      User           @relation(fields: [schoolId, createdById], references: [schoolId, id], onDelete: Restrict)

  @@index([schoolId, courseOfferingId, status])
  @@index([schoolId, createdById])
  @@map("learning_resources")
}

// ============================================================================
// 5. COURSEWORK, ASSESSMENTS & GRADING
// ============================================================================

model Assignment {
  id               String        @id @default(uuid()) @db.Uuid
  schoolId         String        @map("school_id") @db.Uuid
  courseOfferingId String        @map("course_offering_id") @db.Uuid
  createdById      String        @map("created_by_id") @db.Uuid
  title            String        @db.VarChar(200)
  instructions     String        @db.Text
  maxPoints        Decimal       @map("max_points") @db.Decimal(6, 2)
  dueDate          DateTime      @map("due_date") @db.Timestamptz(6)
  status           PublishStatus @default(DRAFT)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  school         School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  courseOffering CourseOffering         @relation(fields: [schoolId, courseOfferingId], references: [schoolId, id], onDelete: Cascade)
  createdBy      User                   @relation(fields: [schoolId, createdById], references: [schoolId, id], onDelete: Restrict)
  submissions    AssignmentSubmission[]

  @@unique([schoolId, id])
  @@index([schoolId, courseOfferingId, dueDate])
  @@index([schoolId, createdById])
  @@map("assignments")
}

model AssignmentSubmission {
  id           String           @id @default(uuid()) @db.Uuid
  schoolId     String           @map("school_id") @db.Uuid
  assignmentId String           @map("assignment_id") @db.Uuid
  studentId    String           @map("student_id") @db.Uuid
  gradedById   String?          @map("graded_by_id") @db.Uuid
  status       SubmissionStatus @default(SUBMITTED)
  content      String?          @db.Text
  fileKey      String?          @map("file_key") @db.VarChar(512)
  score        Decimal?         @db.Decimal(6, 2)
  submittedAt  DateTime         @default(now()) @map("submitted_at") @db.Timestamptz(6)
  gradedAt     DateTime?        @map("graded_at") @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  school     School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignment Assignment     @relation(fields: [schoolId, assignmentId], references: [schoolId, id], onDelete: Restrict)
  student    StudentProfile @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Restrict)
  gradedBy   User?          @relation(fields: [schoolId, gradedById], references: [schoolId, id], onDelete: Restrict)
  feedbacks  Feedback[]

  @@unique([schoolId, id])
  @@unique([schoolId, assignmentId, studentId])
  @@index([schoolId, assignmentId, status])
  @@index([schoolId, studentId])
  @@map("assignment_submissions")
}

model Assessment {
  id               String   @id @default(uuid()) @db.Uuid
  schoolId         String   @map("school_id") @db.Uuid
  courseOfferingId String   @map("course_offering_id") @db.Uuid
  createdById      String   @map("created_by_id") @db.Uuid
  title            String   @db.VarChar(200)
  assessmentDate   DateTime @map("assessment_date") @db.Date
  weightPercentage Decimal  @map("weight_percentage") @db.Decimal(5, 2)
  maxMarks         Decimal  @map("max_marks") @db.Decimal(6, 2)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school         School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  courseOffering CourseOffering     @relation(fields: [schoolId, courseOfferingId], references: [schoolId, id], onDelete: Restrict)
  createdBy      User               @relation(fields: [schoolId, createdById], references: [schoolId, id], onDelete: Restrict)
  results        AssessmentResult[]

  @@unique([schoolId, id])
  @@index([schoolId, courseOfferingId, assessmentDate])
  @@index([schoolId, createdById])
  @@map("assessments")
}

model AssessmentResult {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  assessmentId String   @map("assessment_id") @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  recordedById String   @map("recorded_by_id") @db.Uuid
  score        Decimal  @db.Decimal(6, 2)
  gradeLetter  String?  @map("grade_letter") @db.VarChar(8)
  notes        String?  @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school     School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assessment Assessment     @relation(fields: [schoolId, assessmentId], references: [schoolId, id], onDelete: Restrict)
  student    StudentProfile @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Restrict)
  recordedBy User           @relation(fields: [schoolId, recordedById], references: [schoolId, id], onDelete: Restrict)
  feedbacks  Feedback[]

  @@unique([schoolId, id])
  @@unique([schoolId, assessmentId, studentId])
  @@index([schoolId, assessmentId])
  @@index([schoolId, studentId])
  @@map("assessment_results")
}

model Feedback {
  id                 String   @id @default(uuid()) @db.Uuid
  schoolId           String   @map("school_id") @db.Uuid
  submissionId       String?  @map("submission_id") @db.Uuid
  assessmentResultId String?  @map("assessment_result_id") @db.Uuid
  authorId           String   @map("author_id") @db.Uuid
  comment            String   @db.Text
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school           School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  submission       AssignmentSubmission? @relation(fields: [schoolId, submissionId], references: [schoolId, id], onDelete: Cascade)
  assessmentResult AssessmentResult?     @relation(fields: [schoolId, assessmentResultId], references: [schoolId, id], onDelete: Cascade)
  author           User                  @relation(fields: [schoolId, authorId], references: [schoolId, id], onDelete: Restrict)

  @@index([schoolId, submissionId])
  @@index([schoolId, assessmentResultId])
  @@index([schoolId, authorId])
  @@map("feedbacks")
}

// ============================================================================
// 6. SUPPORT, INTERVENTION & PROGRESS
// ============================================================================

model ProgressSnapshot {
  id                       String   @id @default(uuid()) @db.Uuid
  schoolId                 String   @map("school_id") @db.Uuid
  studentId                String   @map("student_id") @db.Uuid
  academicYearId           String   @map("academic_year_id") @db.Uuid
  periodStart              DateTime @map("period_start") @db.Date
  periodEnd                DateTime @map("period_end") @db.Date
  attendanceRate           Decimal  @map("attendance_rate") @db.Decimal(5, 2)
  assignmentCompletionRate Decimal  @map("assignment_completion_rate") @db.Decimal(5, 2)
  weightedAverageScore     Decimal? @map("weighted_average_score") @db.Decimal(5, 2)
  computedAt               DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  school       School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      StudentProfile @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Cascade)
  academicYear AcademicYear   @relation(fields: [schoolId, academicYearId], references: [schoolId, id], onDelete: Cascade)

  @@unique([schoolId, studentId, academicYearId, periodStart, periodEnd])
  @@index([schoolId, studentId, periodEnd])
  @@map("progress_snapshots")
}

model SupportPlan {
  id             String            @id @default(uuid()) @db.Uuid
  schoolId       String            @map("school_id") @db.Uuid
  studentId      String            @map("student_id") @db.Uuid
  leadTeacherId  String            @map("lead_teacher_id") @db.Uuid
  problemSummary String            @map("problem_summary") @db.Text
  targetGoal     String            @map("target_goal") @db.Text
  reviewDate     DateTime          @map("review_date") @db.Date
  status         SupportPlanStatus @default(DRAFT)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  school      School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student     StudentProfile      @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Restrict)
  leadTeacher User                @relation(fields: [schoolId, leadTeacherId], references: [schoolId, id], onDelete: Restrict)
  linkedFlags SupportFlag[]
  actionItems SupportPlanAction[]
  reviews     SupportReview[]

  @@unique([schoolId, id])
  @@index([schoolId, studentId, status])
  @@index([schoolId, leadTeacherId, status])
  @@index([schoolId, reviewDate])
  @@map("support_plans")
}

model SupportFlag {
  id              String            @id @default(uuid()) @db.Uuid
  schoolId        String            @map("school_id") @db.Uuid
  studentId       String            @map("student_id") @db.Uuid
  reviewedById    String?           @map("reviewed_by_id") @db.Uuid
  supportPlanId   String?           @map("support_plan_id") @db.Uuid
  flagType        SupportFlagType   @map("flag_type")
  severity        SupportSeverity
  rationale       String            @db.Text
  status          SupportFlagStatus @default(PROPOSED)
  dismissalReason String?           @map("dismissal_reason") @db.Text
  reviewedAt      DateTime?         @map("reviewed_at") @db.Timestamptz(6)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  school      School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student     StudentProfile @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Restrict)
  reviewedBy  User?          @relation(fields: [schoolId, reviewedById], references: [schoolId, id], onDelete: Restrict)
  supportPlan SupportPlan?   @relation(fields: [schoolId, supportPlanId], references: [schoolId, id], onDelete: Restrict)

  @@index([schoolId, status, createdAt(sort: Desc)])
  @@index([schoolId, studentId, status])
  @@index([schoolId, supportPlanId])
  @@map("support_flags")
}

model SupportPlanAction {
  id            String           @id @default(uuid()) @db.Uuid
  schoolId      String           @map("school_id") @db.Uuid
  supportPlanId String           @map("support_plan_id") @db.Uuid
  assigneeId    String           @map("assignee_id") @db.Uuid
  description   String           @db.Text
  dueDate       DateTime         @map("due_date") @db.Date
  status        ActionItemStatus @default(PENDING)
  completedAt   DateTime?        @map("completed_at") @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  school      School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  supportPlan SupportPlan @relation(fields: [schoolId, supportPlanId], references: [schoolId, id], onDelete: Cascade)
  assignee    User        @relation(fields: [schoolId, assigneeId], references: [schoolId, id], onDelete: Restrict)

  @@index([schoolId, supportPlanId, status])
  @@index([schoolId, assigneeId, dueDate])
  @@map("support_plan_actions")
}

model SupportReview {
  id            String               @id @default(uuid()) @db.Uuid
  schoolId      String               @map("school_id") @db.Uuid
  supportPlanId String               @map("support_plan_id") @db.Uuid
  reviewerId    String               @map("reviewer_id") @db.Uuid
  reviewDate    DateTime             @map("review_date") @db.Date
  outcomeStatus SupportReviewOutcome @map("outcome_status")
  notes         String               @db.Text
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  school      School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  supportPlan SupportPlan @relation(fields: [schoolId, supportPlanId], references: [schoolId, id], onDelete: Cascade)
  reviewer    User        @relation(fields: [schoolId, reviewerId], references: [schoolId, id], onDelete: Restrict)

  @@index([schoolId, supportPlanId, reviewDate])
  @@index([schoolId, reviewerId])
  @@map("support_reviews")
}

// ============================================================================
// 7. SYSTEM AUDIT
// ============================================================================

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  schoolId   String?  @map("school_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(120)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String   @map("entity_id") @db.Uuid
  delta      Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actor  User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt(sort: Desc)])
  @@index([schoolId, entityType, entityId])
  @@index([actorId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
