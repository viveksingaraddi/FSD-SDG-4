{
  "name": "@fsd-sdg4/api",
  "version": "0.0.0",
  "private": true,
  "description": "FSD-SDG-4 Express API backend — modular monolith, /api/v1, TypeScript strict",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run integration.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "clean": "rimraf dist"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fsd-sdg4/contracts": "workspace:*",
    "@fsd-sdg4/shared-types": "workspace:*",
    "@fsd-sdg4/validation": "workspace:*",
    "@prisma/client": "6.19.3",
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "pino-pretty": "13.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "prisma": "6.19.3",
    "rimraf": "6.1.4",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "^5.8.2",
    "vitest": "5.1.0"
  }
}
