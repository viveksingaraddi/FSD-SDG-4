{
  "name": "@fsd-sdg4/api",
  "version": "0.0.0",
  "private": true,
  "description": "FSD-SDG-4 Express API backend — modular monolith, /api/v1, TypeScript strict",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude src/**/*.integration.test.ts",
    "test:integration": "vitest run src/**/*.integration.test.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@fsd-sdg4/contracts": "workspace:*",
    "@fsd-sdg4/shared-types": "workspace:*",
    "@fsd-sdg4/validation": "workspace:*",
    "express": "5.3.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "pino-pretty": "13.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "rimraf": "6.1.4",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "^5.8.2",
    "vitest": "5.1.0"
  }
}
