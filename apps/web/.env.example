# FSD-SDG-4 Web App — Environment Variable Template
# Copy this file to .env for local development.
# NEVER commit .env to source control.
# Vite exposes ONLY variables prefixed with VITE_ to the browser bundle.
# NEVER put secrets or backend credentials in VITE_ variables.

# API base URL — proxied through Vite dev server in development
VITE_API_BASE_URL=http://localhost:3001
VITE_APP_VERSION=0.0.0-dev
VITE_APP_ENV=development

